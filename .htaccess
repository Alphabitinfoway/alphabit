# Custom 404 Page (Served from public_html/404.html)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

<FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$">
    Require all granted
</FilesMatch>

Options -MultiViews
RewriteEngine On
RewriteBase /

# Force HTTPS on Live Server (Ignored on localhost/XAMPP)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# ---------------------------------------------------------
# ASSET ROUTING (Points subfolder asset calls to public_html/assets/)
# ---------------------------------------------------------
RewriteCond %{REQUEST_URI} !^/assets/
RewriteRule ^.*/assets/(.*)$ /assets/$1 [L,NC]

# Serve real files and directories directly from public_html/
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------
# REWRITE & REDIRECT RULES
# ---------------------------------------------------------

# Redirect index.html to root /
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^(.*)index\.html$ / [R=301,L]

# About
RewriteRule ^about/?$ /aboutus [R=301,L]
RewriteRule ^aboutus/?$ about.html [L]

# Blog
RewriteRule ^blog/?$ /blogs [R=301,L]
RewriteRule ^blogs/?$ blog.html [L]
RewriteRule ^blogs/([^/]+)/?$ blogdetails.html?slug=$1 [NC,L,QSA]
RewriteRule ^blog-details/([^/]+)/?$ blogdetails.html?slug=$1 [NC,L,QSA]

# Case Studies
RewriteRule ^case-studies/?$ case-studies.html [L]
RewriteRule ^case-study/([^/]+)/?$ casestudydetails.html?slug=$1 [NC,L,QSA]
RewriteRule ^casestudydetails/?$ casestudydetails.html [L]

# Contact
RewriteRule ^contact/?$ /contact-us [R=301,L]
RewriteRule ^contact-us/?$ contact.html [L]

# ---------------------------------------------------------
# DIRECT SERVICE URL STRUCTURE (Without /services/ subfolder)
# ---------------------------------------------------------

# Main Services Page
RewriteRule ^services/?$ services.html [L]

# AI & Machine Learning Service Page
RewriteRule ^ai-machine-learning/?$ /ai-and-machine-learning-development-services [R=301,L]
RewriteRule ^ai-and-machine-learning-development-services/?$ ai-machine-learning.html [L]

# Cyber Security & Compliance Service Page
RewriteRule ^cyber-security/?$ /ai-cyber-security-and-compliance-services [R=301,L]
RewriteRule ^ai-cyber-security-and-compliance-services/?$ cyber-security.html [L]

# Full Stack Web Development Service Page
RewriteRule ^ai-full-stack-development-services/?$ ai-full-stack-development-services.html [L]

# Mobile App & Product Design Service Page
RewriteRule ^ai-mobile-app-development-services/?$ ai-mobile-app-development-services.html [L]

# 301 Redirect old /services/... URLs to new Direct URLs
RewriteRule ^services/ai-and-machine-learning-development-services/?$ /ai-and-machine-learning-development-services [R=301,L]
RewriteRule ^services/ai-machine-learning/?$ /ai-and-machine-learning-development-services [R=301,L]
RewriteRule ^services/ai-cyber-security-and-compliance-services/?$ /ai-cyber-security-and-compliance-services [R=301,L]
RewriteRule ^services/cyber-security/?$ /ai-cyber-security-and-compliance-services [R=301,L]
RewriteRule ^services/ai-full-stack-development-services/?$ /ai-full-stack-development-services [R=301,L]
RewriteRule ^services/ai-mobile-app-development-services/?$ /ai-mobile-app-development-services [R=301,L]

# Redirect old blogdetails?slug=xxx to /blog-details/xxx
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+) [NC]
RewriteRule ^blogdetails(?:\.html)?$ /blog-details/%1? [R=301,L]

# Redirect old casestudydetails?slug=xxx to /case-study/xxx
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+) [NC]
RewriteRule ^casestudydetails(?:\.html)?$ /case-study/%1? [R=301,L]

# Match existing .html pages without extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# ---------------------------------------------------------
# 404 ERROR PAGE FOR NON-EXISTENT URLS
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^ - [R=404,L]

# Remove trailing slashes (unless directory)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Redirect /page.html to /page
RewriteCond %{THE_REQUEST} /([^/]+)\.html [NC]
RewriteCond %1 !=index
RewriteRule ^ /%1 [NC,L,R=301]

# ----------------------------------------------------------------------
# | Compression & Caching Headers                                      |
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/x-font-ttf application/vnd.ms-fontobject font/opentype font/ttf font/otf image/svg+xml image/x-icon
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public, no-transform"
    </FilesMatch>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    Header unset ETag
    Header set Connection keep-alive
</IfModule>
FileETag None

Options -Indexes
