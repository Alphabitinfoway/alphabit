# Custom 404 Redirect
# On live server, this should be /404.html. On XAMPP it was /alphabit/404.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

<FilesMatch "\.(css|js|jpg|png|svg)$">
    Require all granted
</FilesMatch>

# Remove .html extension from URLs
Options -MultiViews
RewriteEngine On

# ---------------------------------------------------------
# IMPORTANT:
# For LIVE SERVER, use RewriteBase /
# For LOCAL XAMPP, use RewriteBase /alphabit/
# ---------------------------------------------------------
RewriteBase /

# Redirect about to aboutus
RewriteRule ^about/?$ aboutus [R=301,L]

# Serve the new URL from the existing about.html page
RewriteRule ^aboutus/?$ about.html [L]

# Redirect blog to blogs
# RewriteRule ^blog/?$ blogs [R=301,L]

# Serve the new URL from the existing blog.html page
RewriteRule ^blogs/?$ blog.html [L]

# Redirect contact to contact-us
RewriteRule ^contact/?$ contact-us [R=301,L]

# Serve the new URL from the existing contact.html page
RewriteRule ^contact-us/?$ contact.html [L]

# Redirect obsolete AI page to updated URL
RewriteRule ^ai-machine-learning/?$ ai-and-machine-learning-development-services [R=301,L]

# Serve the new URL from the existing ai-machine-learning.html page
RewriteRule ^ai-and-machine-learning-development-services/?$ ai-machine-learning.html [L]

# Redirect obsolete Cyber Security page to updated URL
RewriteRule ^cyber-security/?$ ai-cyber-security-and-compliance-services [R=301,L]

# Serve the new URL from the existing cyber-security.html page
RewriteRule ^ai-cyber-security-and-compliance-services/?$ cyber-security.html [L]

# Redirect old blogdetails?slug=xxx to /xxx
RewriteCond %{QUERY_STRING} ^slug=([^&]+) [NC]
RewriteRule ^blogdetails(?:\.html)?$ %1? [R=301,L]

# If the request is not for a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Check if the corresponding .html file exists
RewriteCond %{REQUEST_FILENAME}.html -f
# Rewrite /page to /page.html
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# If .html doesn't exist, route to blogdetails.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^([^\.]+)$ blogdetails.html?slug=$1 [NC,L,QSA]

# Remove trailing slashes (unless it's a directory)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ $1 [L,R=301]

# Redirect index.html to root
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^(.*)index\.html$ / [R=301,L]

# Redirect /page.html to /page (remove extension from browser URL)
RewriteCond %{THE_REQUEST} /([^/]+)\.html [NC]
# Make sure we don't redirect index.html again
RewriteCond %1 !=index
RewriteRule ^ %1 [NC,L,R=301]

# ----------------------------------------------------------------------
# | Gzip/Deflate Compression                                           |
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    # Force compression for XML, HTML, CSS, JS, SVG, and Fonts
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
</IfModule>

# ----------------------------------------------------------------------
# | Browser Caching (Expires Headers)                                  |
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # CSS / JS
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # HTML (keep fresh for changes)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# | Cache-Control Headers                                              |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Cache static assets
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public, no-transform"
    </FilesMatch>
    # Don't cache HTML/PHP to avoid showing outdated dynamic content
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>


