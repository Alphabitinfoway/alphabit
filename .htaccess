# Custom 404 Redirect
# Use project subfolder path so XAMPP/Apache finds the file correctly
ErrorDocument 404 /alphabit/404.html

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

<FilesMatch "\.(css|js|jpg|png|svg)$">
    Require all granted
</FilesMatch>

# Remove .html extension from URLs
Options -MultiViews
RewriteEngine On
# Set RewriteBase to the project folder so rules work under /alphabit/
RewriteBase /alphabit/

# Redirect about to aboutus
RewriteRule ^about/?$ /alphabit/aboutus [R=301,L]

# Serve the new URL from the existing about.html page
RewriteRule ^aboutus/?$ about.html [L]

# Redirect blog to blogs
RewriteRule ^blog/?$ /alphabit/blogs [R=301,L]

# Serve the new URL from the existing blog.html page
RewriteRule ^blogs/?$ blog.html [L]

# Redirect contact to contact-us
RewriteRule ^contact/?$ /alphabit/contact-us [R=301,L]

# Serve the new URL from the existing contact.html page
RewriteRule ^contact-us/?$ contact.html [L]

# Redirect obsolete AI page to updated URL
RewriteRule ^ai-machine-learning/?$ /alphabit/ai-and-machine-learning-development-services [R=301,L]

# Serve the new URL from the existing ai-machine-learning.html page
RewriteRule ^ai-and-machine-learning-development-services/?$ ai-machine-learning.html [L]

# Redirect obsolete Cyber Security page to updated URL
RewriteRule ^cyber-security/?$ /alphabit/ai-cyber-security-and-compliance-services [R=301,L]

# Serve the new URL from the existing cyber-security.html page
RewriteRule ^ai-cyber-security-and-compliance-services/?$ cyber-security.html [L]

# If the request is not for a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite /page to /page.html
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Redirect /page.html to /page (remove extension from browser URL)
# Capture only the last path segment so redirects work from the subfolder
RewriteCond %{THE_REQUEST} /([^/]+)\.html [NC]
RewriteRule ^ %1 [NC,L,R=301]

# ----------------------------------------------------------------------
# | Gzip/Deflate Compression                                           |
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    # Force compression for XML, HTML, CSS, JS, SVG, and Fonts
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
</IfModule>

# ----------------------------------------------------------------------
# | Browser Caching (Expires Headers)                                  |
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # CSS / JS
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # HTML (keep fresh for changes)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# | Cache-Control Headers                                              |
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Cache static assets
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public, no-transform"
    </FilesMatch>
    # Don't cache HTML/PHP to avoid showing outdated dynamic content
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>


